# Local empty-data demo. Production must use MySQL and a stable secret key.
EIC_DATABASE_URL=sqlite+aiosqlite:///./eic.db
EIC_AUTO_CREATE_SCHEMA=false
EIC_RUNTIME_SCHEMA_UPDATES=false
EIC_BOOTSTRAP_ENABLED=true
EIC_JWT_SECRET=replace-before-production-with-a-random-secret
EIC_SECRET_ENCRYPTION_KEY=replace-before-production-with-a-random-secret
EIC_BOOTSTRAP_ADMIN=admin
EIC_BOOTSTRAP_ADMIN_PASSWORD=
EIC_SEED_DEMO_DATA=false
EIC_DEMO_USER_PASSWORD=
EIC_REQUIRE_RUNTIME_DEPENDENCIES=false
EIC_CORS_ORIGINS=http://127.0.0.1:5174
EIC_REDIS_URL=redis://127.0.0.1:6379/0
EIC_VECTOR_DATABASE_URL=postgresql+asyncpg://eic:change-me@127.0.0.1:5432/eic_vector
EIC_QDRANT_URL=http://127.0.0.1:6333
EIC_SKILL_ROOT=skills
EIC_UPLOAD_ROOT=uploads
# 先执行 python -m eic.core.schema upgrade；应用启动不会自动建表。
EIC_ENVIRONMENT=development
EIC_TASK_EXECUTION_ENABLED=false
EIC_CHAT_ATTACHMENTS_ENABLED=false
# 先迁移到 0042_memory_search；存量条目在记忆面板显式重建检索索引。
EIC_MEMORY_CANDIDATE_INDEX_ENABLED=true
# 独立 PG 投影默认关闭；准备对应向量维度的 HNSW 并完成回填后再启用。
EIC_MEMORY_VECTOR_PROJECTION_ENABLED=false

# Langfuse 独立旁路默认关闭；框架门通过后才能在授权隔离环境启用。
# 仅元数据导出；已落盘投递按事件确认，未知结果不自动重发。
EIC_LANGFUSE_ENABLED=false
EIC_LANGFUSE_BASE_URL=
EIC_LANGFUSE_PUBLIC_KEY=
EIC_LANGFUSE_SECRET_KEY=
EIC_LANGFUSE_NAMESPACE=eic
EIC_LANGFUSE_QUEUE_SIZE=256
EIC_LANGFUSE_BATCH_SIZE=32
EIC_LANGFUSE_TIMEOUT_SECONDS=2
EIC_LANGFUSE_SHUTDOWN_SECONDS=2
EIC_LANGFUSE_MAX_RETRIES=1
# 批大小为目标导出对象数；单个业务事件不拆分。持久投递只安全重试全部明确 429。
EIC_LANGFUSE_UI_BASE_URL=
EIC_LANGFUSE_PROJECT_ID=
