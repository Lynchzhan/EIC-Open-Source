# 空项必须由运维填写；未填 digest/secret 不得部署。不要提交真实 .env。
# RUN_ID 使用全新、唯一的小写字母/数字/连字符，长度 8..40。
RUN_ID=
# 首次设为 lf-<RUN_ID>；恢复时保留备份桶名，但卷和网络使用新的 RUN_ID。
OBJECT_BUCKET=
WEB_PORT=13000
OBJECT_PORT=19090
# 仅填官方 registry 核实过的 64 位十六进制 digest，不填 sha256: 前缀。
# 唯一参考目标 v3.100.0，配套 legacy POST /api/public/ingestion。
# WEB/WORKER 必须逐项绑定 Docker Hub 的 v3.100.0 发行镜像，不能用 :3 或 v4。
# PG/CH/MinIO 在该标签 Compose 中未固定版本；Redis 仅 :7；须补逐项配套证据。
# 禁止把 v4 main 的 PG17/CH25.12/Chainguard 结论当作本发行版官方配套。
# PG 所选版本必须使用 /var/lib/postgresql/data；不支持 PG18 默认布局。
WEB_SHA256=
WORKER_SHA256=
PG_SHA256=
CH_SHA256=
REDIS_SHA256=
MINIO_SHA256=
# 运维冷备份 helper，固定 docker.io/library/alpine 仓库；须审核 tar 能力与平台。
HELPER_SHA256=
# 每项独立生成 32 随机字节的 hex（64 字符），禁止复用、全零或示例密码。
PG_PASSWORD=
CH_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
