MYSQL_PASSWORD=replace-before-deployment
MYSQL_ROOT_PASSWORD=replace-before-deployment
POSTGRES_PASSWORD=replace-before-deployment
EIC_DATABASE_URL=mysql+aiomysql://eic:${MYSQL_PASSWORD}@mysql:3306/eic
EIC_VECTOR_DATABASE_URL=postgresql+asyncpg://eic:${POSTGRES_PASSWORD}@postgres:5432/eic_vector
EIC_REDIS_URL=redis://redis:6379/0
EIC_JWT_SECRET=replace-before-deployment
EIC_SECRET_ENCRYPTION_KEY=replace-before-deployment
EIC_BOOTSTRAP_ADMIN=admin
EIC_BOOTSTRAP_ENABLED=false
EIC_AUTO_CREATE_SCHEMA=false
EIC_RUNTIME_SCHEMA_UPDATES=false
EIC_BOOTSTRAP_ADMIN_PASSWORD=replace-before-deployment
EIC_SEED_DEMO_DATA=true
EIC_DEMO_USER_PASSWORD=
EIC_REQUIRE_RUNTIME_DEPENDENCIES=true
EIC_TASK_EXECUTION_ENABLED=false
EIC_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
EIC_QDRANT_URL=http://qdrant:6333
EIC_SKILL_ROOT=/app/skills
EIC_UPLOAD_ROOT=/app/uploads
# 空库首次初始化时显式设置 EIC_BOOTSTRAP_ENABLED=true；完成后改回 false。
EIC_CHAT_ATTACHMENTS_ENABLED=false
EIC_ENVIRONMENT=development
# 仅生产编排需要；填写部署者自行构建或获取并校验的镜像标签。
EIC_BACKEND_IMAGE=
EIC_FRONTEND_IMAGE=

# 可选私有 MinerU sidecar；默认不启用，公网/域名/重定向均拒绝。
EIC_PDF_EXTRACTOR=local
EIC_MINERU_ENDPOINT=
EIC_MINERU_ALLOWED_IPS=
EIC_MINERU_API_KEY=
EIC_MINERU_TIER=basic
EIC_MINERU_OCR_MODE=auto
EIC_MINERU_FALLBACK_LOCAL=true
EIC_MINERU_TIMEOUT_SECONDS=120
EIC_MINERU_POLL_INTERVAL_SECONDS=1
EIC_MINERU_MAX_POLLS=120
EIC_MINERU_MAX_PDF_BYTES=33554432
EIC_MINERU_MAX_RESPONSE_BYTES=16777216
EIC_MINERU_MAX_TEXT_CHARS=2000000
EIC_MINERU_MAX_PAGES=2000
